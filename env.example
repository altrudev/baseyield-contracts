# ─────────────────────────────────────────────────────────────────────────────
#  BaseYield Contracts — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git. It is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC Endpoints ─────────────────────────────────────────────────────────────
# Alchemy free tier — get key at alchemy.com
BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer wallet ───────────────────────────────────────────────────────────
# The wallet that deploys the contract.
# On testnet: use a dedicated throwaway wallet.
# On mainnet: use a hardware wallet via cast wallet or a secure keystore.
# NEVER put a mainnet private key in plain text in any file.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Contract constructor arguments ────────────────────────────────────────────

# Aerodrome Slipstream NonfungiblePositionManager
# Mainnet:  verify at basescan.org/address/aerodrome-slipstream-npm
# Testnet:  verify at sepolia.basescan.org
SLIPSTREAM_NPM_ADDRESS=0x0000000000000000000000000000000000000000

# Gelato Automate contract on Base
# Find at: docs.gelato.network/developer-services/automate/contract-addresses
GELATO_AUTOMATE_ADDRESS=0x0000000000000000000000000000000000000000

# Fee recipient — the address that receives the 7.5% protocol fee
# This is YOUR wallet address as the operator.
# Use a dedicated address, not your deploy wallet.
FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# ── BaseScan verification ─────────────────────────────────────────────────────
# Get API key at basescan.org/register
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
